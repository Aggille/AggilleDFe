<Project>
  <!--
    Versao do AggilleDFe: {ano}.{release}.{build}. O RELEASE so muda quando o
    usuario avisar; o BUILD sobe a cada nova imagem publicada pro cliente (ver
    update-cliente.bat / docker compose build+push). A API grava esse valor
    (via AssemblyInformationalVersionAttribute) no banco a cada start
    (Configuracao.Versao, ver Program.cs).
  -->
  <PropertyGroup>
    <VersaoAno>2026</VersaoAno>
    <VersaoRelease>015</VersaoRelease>
    <VersaoBuild>1001</VersaoBuild>
    <InformationalVersion>$(VersaoAno).$(VersaoRelease).$(VersaoBuild)</InformationalVersion>
    <!-- Sem isso o MSBuild anexa "+<hash-do-commit>" na InformationalVersion,
         estragando o formato ano.release.build exibido no AppBar/login. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
