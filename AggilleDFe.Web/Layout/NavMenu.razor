<MudNavMenu>
    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home" Match="NavLinkMatch.All">Home</MudNavLink>

            @foreach (var item in _itens)
            {
                if (item.Permissao is null || context.User.HasClaim("permissao", item.Permissao))
                {
                    <MudNavLink Href="@item.Rota" Icon="@item.Icone" Match="NavLinkMatch.Prefix">
                        @item.Label
                    </MudNavLink>
                }
            }

            @if (context.User.HasClaim("administrador", "true"))
            {
                <MudNavLink Href="/usuarios" Icon="@Icons.Material.Filled.People" Match="NavLinkMatch.Prefix">
                    Usuários
                </MudNavLink>
            }
        </Authorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    private record ItemMenu(string Label, string Rota, string Icone, string? Permissao);

    private static readonly ItemMenu[] _itens =
    [
        new("Empresas",       "/empresas",        Icons.Material.Filled.Business,      "empresas"),
        new("Configuração",   "/configuracao",    Icons.Material.Filled.Settings,      "configuracao"),
        new("Registros",      "/registros",       Icons.Material.Filled.History,       "registros"),
        new("Baixar XMLs",    "/baixar-xmls",     Icons.Material.Filled.CloudDownload, "baixar-xml"),
        new("Baixar por Chave", "/baixar-por-chave", Icons.Material.Filled.VpnKey,     "baixar-por-chave"),
        new("XMLS Baixados",  "/xmls-baixados",   Icons.Material.Filled.FolderZip,     "xmls-baixados"),
        new("Importar XMLs",  "/importar-xmls",   Icons.Material.Filled.UploadFile,    "importacao"),
        new("Exportar XMLs",  "/exportar-xmls",   Icons.Material.Filled.Archive,       "exportar-xmls"),
    ];
}
