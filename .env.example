# Copie este arquivo para ".env" (mesma pasta do docker-compose.yml) e
# preencha os valores reais antes de rodar "docker compose up".
# ".env" fica de fora do git (ver .gitignore) - nunca commite senha real.

# Senha do usuario "aggilledfe" no Postgres (container "db"). Obrigatoria -
# o compose recusa subir sem isso definido.
POSTGRES_PASSWORD=

# URL da API alcancavel PELO NAVEGADOR do usuario final (nao e a URL interna
# do compose) - usada pelo Web (Blazor WASM) para saber onde chamar a API.
# Ex.: http://192.168.1.10:5007 ou https://dfe.suaempresa.com.br
API_PUBLIC_URL=http://localhost:5007

# URL publica onde o Web vai ficar hospedado - usada pela API para liberar
# no CORS (WebClientOrigins). Ex.: http://192.168.1.10:5071
WEB_PUBLIC_URL=http://localhost:5071
