# Copie este arquivo para ".env" (mesma pasta do docker-compose.yml) e
# preencha os valores reais antes de rodar "docker compose up".
# ".env" fica de fora do git (ver .gitignore) - nunca commite senha real.

# Senha do usuario "aggilledfe" no Postgres (container "db"). Obrigatoria -
# o compose recusa subir sem isso definido.
POSTGRES_PASSWORD=

# OPCIONAL - deixe VAZIO (recomendado). Vazio = o Web (Blazor WASM) chama a
# API na mesma origem em que a pagina foi aberta (http://<host>:5071/api/...)
# e o nginx do container web repassa pra API. Funciona igual por localhost,
# IP da rede, IP externo ou dominio, sem precisar de CORS.
# So preencha pra forcar outra URL, ex.: https://api.suaempresa.com.br
API_PUBLIC_URL=

# URL publica onde o Web vai ficar hospedado - usada pela API para liberar
# no CORS (WebClientOrigins). So importa se API_PUBLIC_URL for preenchida.
# Ex.: http://192.168.1.10:5071
WEB_PUBLIC_URL=http://localhost:5071
