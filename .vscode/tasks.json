{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: API",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/AggilleDFe.API/AggilleDFe.API.csproj",
        "--configuration",
        "Debug",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build: Web",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/AggilleDFe.Web/AggilleDFe.Web.csproj",
        "--configuration",
        "Debug",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build: Todos",
      "dependsOn": ["build: API", "build: Web"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "start: Web",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/AggilleDFe.Web/AggilleDFe.Web.csproj"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "aspnetcore",
        "pattern": [{ "regexp": ".", "file": 1, "location": 2, "message": 3 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^info:",
          "endsPattern": "Now listening on:"
        }
      },
      "group": "none"
    },
    {
      "label": "build:API + start:Web",
      "dependsOn": ["build: API", "start: Web"],
      "dependsOrder": "sequence",
      "problemMatcher": "$msCompile"
    }
  ]
}
