{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API + Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build:API + start:Web",
      "program": "${workspaceFolder}/AggilleDFe.API/bin/Debug/net10.0/AggilleDFe.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/AggilleDFe.API",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5007"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+https?://\\S+",
        "uriFormat": "http://localhost:5071"
      }
    },
    {
      "name": "API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: API",
      "program": "${workspaceFolder}/AggilleDFe.API/bin/Debug/net10.0/AggilleDFe.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/AggilleDFe.API",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5007"
      }
    }
  ]
}
